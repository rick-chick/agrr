{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node scripts/inject-spa-hreflang.mjs",
    "verify:prerender-output": "node --test scripts/verify-prerender-output.test.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "postinstall": "patch-package",
    "check:proxy-conf": "node scripts/proxy-conf-contract.mjs",
    "check-hardcoded-i18n": "node scripts/check-hardcoded-i18n.mjs",
    "check-hardcoded-i18n:enforce": "node scripts/check-hardcoded-i18n.mjs --enforce",
    "check:btn-base-class": "node scripts/check-btn-base-class.mjs",
    "check:btn-base-class:enforce": "node scripts/check-btn-base-class.mjs --enforce",
    "check:ui-composition": "node scripts/check-ui-composition.mjs",
    "check:ui-composition:enforce": "node scripts/check-ui-composition.mjs --enforce",
    "check:wizard-style-scope": "node scripts/check-wizard-style-scope.mjs",
    "check:wizard-style-scope:enforce": "node scripts/check-wizard-style-scope.mjs --enforce",
    "verify:design-system-guide": "node --test scripts/check-design-system-guide.test.mjs",
    "verify:primary-color-tokens": "node --test scripts/check-primary-color-tokens.test.mjs",
    "verify:fluid-typography-tokens": "node --test scripts/check-fluid-typography-tokens.test.mjs",
    "verify:package-deps": "node --test scripts/check-package-deps.test.mjs",
    "test:e2e": "playwright test",
    "test:route-manifest-coverage": "playwright test e2e/route-manifest-coverage.spec.ts --config=playwright.manifest.config.ts",
    "test:e2e:smoke": "E2E_CAPTURE_DEV_SESSION=1 E2E_STRANGLER=1 playwright test e2e/smoke/",
    "test:e2e:smoke:route": "E2E_CAPTURE_DEV_SESSION=1 E2E_STRANGLER=1 playwright test e2e/smoke/route-smoke.spec.ts",
    "test:e2e:smoke:layout": "E2E_CAPTURE_DEV_SESSION=1 E2E_STRANGLER=1 playwright test e2e/smoke/layout-smoke.spec.ts",
    "test:e2e:smoke:wizard-progress": "E2E_CAPTURE_DEV_SESSION=1 E2E_STRANGLER=1 playwright test e2e/smoke/wizard-progress-smoke.spec.ts",
    "test:e2e:smoke:locale-i18n": "E2E_CAPTURE_DEV_SESSION=1 E2E_STRANGLER=1 playwright test e2e/smoke/locale-i18n-smoke.spec.ts",
    "test:e2e:smoke:a11y": "E2E_CAPTURE_DEV_SESSION=1 E2E_STRANGLER=1 playwright test e2e/smoke/a11y-smoke.spec.ts e2e/smoke/gantt-keyboard-alternative.spec.ts e2e/smoke/cookie-consent-focus.spec.ts e2e/smoke/skip-link.spec.ts",
    "test:e2e:smoke:empty-state": "E2E_CAPTURE_DEV_SESSION=1 E2E_STRANGLER=1 playwright test e2e/smoke/empty-state-smoke.spec.ts",
    "test:e2e:research-cta": "playwright test --config=playwright.research.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "e2e:capture-for-agent": "E2E_CAPTURE_DEV_SESSION=1 E2E_STRANGLER=1 playwright test e2e/visual/route-manifest-visual.spec.ts e2e/visual/login-capture-for-agent.spec.ts e2e/visual/empty-state-capture-for-agent.spec.ts && node e2e/agent-review/verify-capture-complete.mjs && node e2e/agent-review/verify-empty-state-capture.mjs",
    "audit:css-tokens": "node scripts/audit-component-css-tokens.mjs",
    "audit:css-tokens:enforce": "node scripts/audit-component-css-tokens.mjs --enforce",
    "e2e:manifest": "node scripts/generate-e2e-route-manifest.mjs",
    "e2e:manifest:check": "node scripts/generate-e2e-route-manifest.mjs --check",
    "e2e:layout-contract:check": "node e2e/smoke/verify-layout-contract-coverage.mjs",
    "e2e:layout-contract:check:enforce": "node e2e/smoke/verify-layout-contract-coverage.mjs --enforce --require-conformance-explicit",
    "e2e:visual-review:check": "node e2e/agent-review/verify-visual-review-fresh.mjs",
    "e2e:visual-review:check:enforce": "node e2e/agent-review/verify-visual-review-fresh.mjs --enforce",
    "lighthouse:ci": "lhci autorun --config=lighthouserc.js",
    "e2e:agent-review:evidence:check": "node e2e/agent-review/verify-agent-review-evidence.mjs",
    "e2e:agent-review:evidence:check:enforce": "node e2e/agent-review/verify-agent-review-evidence.mjs --enforce"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@9.2.0",
  "dependencies": {
    "@angular/cdk": "^21.2.9",
    "@angular/common": "^21.2.11",
    "@angular/compiler": "^21.2.11",
    "@angular/core": "^21.2.11",
    "@angular/forms": "^21.2.11",
    "@angular/platform-browser": "^21.2.11",
    "@angular/router": "^21.2.11",
    "@bluehalo/ngx-leaflet": "^21.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@types/actioncable": "^5.2.11",
    "@types/leaflet": "^1.9.21",
    "actioncable": "^5.2.8-1",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "ng2-charts": "^8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.11",
    "@angular/platform-server": "^21.2.11",
    "@angular/ssr": "^21.2.9",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^26.1.1",
    "angular-eslint": "^21.3.1",
    "eslint": "^9.39.4",
    "jsdom": "^27.1.0",
    "parse5": "^7.1.2",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.0.8",
    "zone.js": "^0.16.0"
  }
}
